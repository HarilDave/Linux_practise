#include <linux/kernel.h>
#include <linux/init.h>
#include <linux/module.h>
#include <linux/kdev_t.h>
#include <linux/fs.h>
#include <linux/cdev.h>
#include <linux/device.h>
#include <linux/timer.h>
#include <linux/jiffies.h>

#define TIMEOUT 5000   // ms

static struct timer_list my_timer;
static unsigned int count = 0;

static dev_t dev;
static struct class *myclass;
static struct cdev mycdev;

/* ---------------------- File Operations ---------------------- */

static int my_open(struct inode *inode, struct file *file)
{
    pr_info("open\n");
    return 0;
}

static int my_release(struct inode *inode, struct file *file)
{
    pr_info("release\n");
    return 0;
}

static ssize_t my_read(struct file *filp, char __user *buf, size_t len, loff_t *off)
{
    pr_info("read\n");
    return 0;
}

static ssize_t my_write(struct file *filp, const char __user *buf, size_t len, loff_t *off)
{
    pr_info("write\n");
    return len;
}

static struct file_operations fops =
{
    .owner   = THIS_MODULE,
    .read    = my_read,
    .write   = my_write,
    .open    = my_open,
    .release = my_release,
};

/* ---------------------- Timer Callback ---------------------- */

static void my_timer_callback(struct timer_list *t)
{
    pr_info("Timer Callback [%d]\n", count++);
    mod_timer(&my_timer, jiffies + msecs_to_jiffies(TIMEOUT));
}

/* ---------------------- Module Init ---------------------- */

static int __init my_driver_init(void)
{
    if (alloc_chrdev_region(&dev, 0, 1, "mytimer") < 0)
        return -1;

    cdev_init(&mycdev, &fops);
    if (cdev_add(&mycdev, dev, 1) < 0)
        goto r_chrdev;

    myclass = class_create(THIS_MODULE, "mytimer_class");
    if (IS_ERR(myclass))
        goto r_class;

    if (IS_ERR(device_create(myclass, NULL, dev, NULL, "mytimer")))
        goto r_device;

    timer_setup(&my_timer, my_timer_callback, 0);
    mod_timer(&my_timer, jiffies + msecs_to_jiffies(TIMEOUT));

    pr_info("Timer Driver Loaded\n");
    return 0;

r_device:
    class_destroy(myclass);
r_class:
    cdev_del(&mycdev);
r_chrdev:
    unregister_chrdev_region(dev, 1);
    return -1;
}

/* ---------------------- Module Exit ---------------------- */

static void __exit my_driver_exit(void)
{
    del_timer(&my_timer);
    device_destroy(myclass, dev);
    class_destroy(myclass);
    cdev_del(&mycdev);
    unregister_chrdev_region(dev, 1);

    pr_info("Timer Driver Removed\n");
}

module_init(my_driver_init);
module_exit(my_driver_exit);

