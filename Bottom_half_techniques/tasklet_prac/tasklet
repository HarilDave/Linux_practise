#include <linux/module.h>
#include <linux/kernel.h>
#include <linux/init.h>
#include <linux/gpio.h>
#include <linux/interrupt.h>

#define GPIO_BUTTON 25

static int gpio_irq;

static void tasklet_fn(unsigned long data)
{
    pr_info("Tasklet bottom half executed\n");
}

DECLARE_TASKLET(my_tasklet, tasklet_fn, 0);

static irqreturn_t gpio_irq_handler(int irq, void *dev_id)
{
    tasklet_schedule(&my_tasklet);
    return IRQ_HANDLED;
}

static int __init my_init(void)
{
    gpio_request(GPIO_BUTTON, "gpio_button");
    gpio_direction_input(GPIO_BUTTON);

    gpio_irq = gpio_to_irq(GPIO_BUTTON);
    request_irq(gpio_irq, gpio_irq_handler, IRQF_TRIGGER_RISING, "gpio_tasklet_irq", NULL);

    pr_info("GPIO Tasklet driver loaded\n");
    return 0;
}

static void __exit my_exit(void)
{
    tasklet_kill(&my_tasklet);
    free_irq(gpio_irq, NULL);
    gpio_free(GPIO_BUTTON);

    pr_info("GPIO Tasklet driver unloaded\n");
}

module_init(my_init);
module_exit(my_exit);

MODULE_LICENSE("GPL");
MODULE_AUTHOR("HARIL");

